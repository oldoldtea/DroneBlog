# DroneBlog MCP Server — 环境变量示例
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，切勿提交真实密钥。

# 必填：博客工作目录（包含 _config.yml 的目录）
DRONEBLOG_DIR=/path/to/your/blog

# AI 生成所需（无密钥时 blog_generate/pipeline_run 会报错）
OPENAI_API_KEY=sk-...
# 兼容/代理端点（默认 https://api.openai.com/v1，国内可填代理地址）
DRONEBLOG_OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：模型与采样参数
DRONEBLOG_MODEL=gpt-4o-mini
DRONEBLOG_TEMPERATURE=0.7
DRONEBLOG_MAX_TOKENS=4000

# 可选：GitHub 绑定/自动部署（推荐用环境变量，避免 --token 进进程列表）
DRONEBLOG_GITHUB_TOKEN=ghp_...
