#!/bin/sh
# pre-commit — 提交前快速校验
# 职责：仅做轻量检查（格式、Front-matter、敏感信息），不执行构建
# 原则：快速（<1秒）、有用、可跳过

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo "[pre-commit] 开始提交前校验..."

# ---------------------------------------------------------------------------
# 1. 校验暂存区 Markdown 文件的 Front-matter
# ---------------------------------------------------------------------------
MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$MD_FILES" ]; then
  echo "[pre-commit] 校验 Markdown Front-matter..."
  for file in $MD_FILES; do
    # 只检查博客文章和草稿
    case "$file" in
      source/_posts/*|source/_drafts/*|scaffolds/*)
        ;;
      *)
        continue
        ;;
    esac

    # 检查是否以 --- 开头
    HEAD_LINE=$(head -n 1 "$file" 2>/dev/null || echo "")
    if [ "$HEAD_LINE" != "---" ]; then
      echo "${RED}[ERROR]${NC} $file: 缺少 YAML Front-matter（应以 --- 开头）"
      ERRORS=$((ERRORS + 1))
      continue
    fi

    # 检查 title 字段
    if ! head -n 20 "$file" | grep -qE '^title:\s*.+'; then
      echo "${RED}[ERROR]${NC} $file: Front-matter 中缺少 title 字段"
      ERRORS=$((ERRORS + 1))
    fi

    # 检查 date 字段格式（YYYY-MM-DD HH:mm:ss）
    DATE_LINE=$(head -n 20 "$file" | grep -E '^date:' || true)
    if [ -n "$DATE_LINE" ]; then
      if ! echo "$DATE_LINE" | grep -qE '^date:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}'; then
        echo "${YELLOW}[WARNING]${NC} $file: date 格式可能不正确，应为 'YYYY-MM-DD HH:mm:ss'"
      fi
    fi
  done
fi

# ---------------------------------------------------------------------------
# 2. 校验文件名规范（ASCII、无空格）
# ---------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -n "$STAGED_FILES" ]; then
  echo "[pre-commit] 校验文件名规范..."
  for file in $STAGED_FILES; do
    # 检查是否包含空格
    case "$file" in
      *" "*)
        echo "${YELLOW}[WARNING]${NC} 文件名包含空格: $file"
        ;;
    esac

    # 检查博客文章文件名是否为 ASCII
    case "$file" in
      source/_posts/*|source/_drafts/*)
        BASENAME=$(basename "$file")
        if ! echo "$BASENAME" | grep -qE '^[a-zA-Z0-9_.-]+$'; then
          echo "${YELLOW}[WARNING]${NC} 博客文件名建议仅使用 ASCII 字符: $BASENAME"
        fi
        ;;
    esac
  done
fi

# ---------------------------------------------------------------------------
# 3. 敏感信息扫描（WARNING 级别，不阻塞）
# ---------------------------------------------------------------------------
echo "[pre-commit] 扫描敏感信息..."

if [ -n "$STAGED_FILES" ]; then
  PATTERNS="(api[_-]?key|apikey|token|password|secret|private[_-]?key|access[_-]?key)[[:space:]]*[:=][[:space:]]*[^[:space:]]{8,}"

  MATCHES=$(git diff --cached --diff-filter=ACM -U0 | grep -iE "$PATTERNS" || true)
  if [ -n "$MATCHES" ]; then
    echo "${YELLOW}[WARNING]${NC} 检测到可能的敏感信息模式："
    echo "$MATCHES" | head -n 5
    echo "${YELLOW}请确认是否包含真实凭证。如确认安全，使用 git commit --no-verify 跳过。${NC}"
  fi
fi

# ---------------------------------------------------------------------------
# 结果汇总
# ---------------------------------------------------------------------------
if [ "$ERRORS" -gt 0 ]; then
  echo "${RED}[pre-commit] 校验失败，发现 $ERRORS 个错误。${NC}"
  echo "请修复后重新提交，或使用 git commit --no-verify 强制提交。"
  exit 1
else
  echo "${GREEN}[pre-commit] 校验通过。${NC}"
  echo "[pre-commit] 提示: CI 将在 push 后自动执行 hexo generate 构建校验。"
  exit 0
fi
