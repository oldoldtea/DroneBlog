#!/bin/sh
# pre-push — 推送前校验钩子
# 校验项：hexo generate 是否能正常构建

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "[pre-push] 开始推送前构建校验..."

# 检查是否在项目根目录（通过 package.json 判断）
if [ ! -f "package.json" ]; then
  echo "${YELLOW}[WARNING]${NC} 未找到 package.json，跳过构建校验。"
  exit 0
fi

# 检查 hexo 是否可用
if ! command -v npx >/dev/null 2>&1; then
  echo "${YELLOW}[WARNING]${NC} npx 不可用，跳过构建校验。"
  exit 0
fi

echo "[pre-push] 执行 hexo clean && hexo generate..."

# 执行构建
if npx hexo clean >/dev/null 2>&1 && npx hexo generate >/dev/null 2>&1; then
  echo "${GREEN}[pre-push] 构建校验通过。${NC}"
  exit 0
else
  echo "${RED}[pre-push] 构建失败！${NC}"
  echo "请执行 'hexo clean && hexo generate' 查看详细错误并修复。"
  echo "修复后可重新推送，或使用 git push --no-verify 强制推送。"
  exit 1
fi
